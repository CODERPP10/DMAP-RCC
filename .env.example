# Copy to .env for local development (.env is gitignored).

# Node environment: development | production
NODE_ENV=development

# Port the app (Express + client) listens on.
PORT=5000

# Public address Caddy serves (Docker/Phase 3). "localhost" for local HTTPS via
# Caddy's internal CA; a real domain (e.g. dmaprcc.example.com) for Let's Encrypt.
SITE_ADDRESS=localhost

# Contact form email delivery (Gmail SMTP + App Password).
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled). NEVER commit the real values.
MAIL_USER=your-account@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_TO=destination-inbox@example.com

# Contact-form mail delivery via the Resend HTTP API (functions/api/contact.ts).
#
# Local dev: copy the values into a gitignored `.dev.vars` file (same KEY=VALUE
# format) — `wrangler pages dev` loads it automatically.
# Production/Preview: set these in the Cloudflare Pages project settings, not here.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. Without a verified domain, Resend only allows "onboarding@resend.dev"
# (and only delivers to the Resend account's own email). Swap for an address on your
# domain once it's verified in Resend.
MAIL_FROM=onboarding@resend.dev

# Where contact submissions are delivered.
MAIL_TO=you@example.com

# Reverse proxy for the DMAP site. Caddy terminates TLS and is the only
# process exposed to the internet; the app listens on an internal network only.
#
# Set SITE_ADDRESS in .env:
#   - "localhost"            -> local HTTP(S) with Caddy's internal CA
#   - "dmaprcc.example.com"  -> public domain, automatic Let's Encrypt TLS

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Cap request bodies (contact form is tiny JSON).
	request_body {
		max_size 64KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:5000
}
